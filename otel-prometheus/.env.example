# Azure Monitor workspace metrics ingestion endpoint (no trailing path).
# Found on the Azure Monitor workspace Overview page.
AZURE_MONITOR_INGESTION_ENDPOINT=https://<workspace>.<region>-1.metrics.ingest.monitor.azure.com

# Immutable ID of the workspace's default data collection rule (dcr-...).
AZURE_MONITOR_DCR_IMMUTABLE_ID=dcr-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides.
# AZURE_MONITOR_API_VERSION=2023-04-24
# OTEL_SERVICE_NAME=otel-prometheus-demo
# OTEL_JOB=otel-prometheus-demo
# OTEL_INSTANCE_ID=my-host
# EXPORT_INTERVAL_SECONDS=15
# RUN_SECONDS=0   # 0 = run until interrupted
